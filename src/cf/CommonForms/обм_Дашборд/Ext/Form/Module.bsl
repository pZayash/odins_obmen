#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Для ИР
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
		
	КонецЕсли;
	
	// ponytail: View формы достаточно. Просмотр подсистемы обм_Интерфейсная
	// нет у ПолныеПрава (роль без явного права на старую подсистему) -> silent Отказ.
	Если Не ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.обм_Дашборд) Тогда
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	ОбновитьСводкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОбновитьСводку", 60, Ложь);
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьСводку();
	
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НажатиеПерехода(Элемент)
	
	// ponytail: не имяФормы - коллизия с read-only свойством формы ИмяФормы.
	Если Не ЭтаФорма.КартаПереходов.Свойство(Элемент.Имя) Тогда
		Возврат;
		
	КонецЕсли;
	
	переход = ЭтаФорма.КартаПереходов[Элемент.Имя];
	Если ТипЗнч(переход) = Тип("Структура") Тогда
		ОткрытьФорму(переход.ИмяФормы, переход.Параметры, , Элемент.Имя);
		Возврат;
		
	КонецЕсли;
	
	ОткрытьФорму(переход);
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийЭлементовШапкиФормы

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьСводку()
	
	ОбновитьСводкуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСводкуНаСервере()
	
	сводка = Обработки.обм_Дашборд.Сводка();
	ЭтаФорма.КартаПереходов = Новый Структура;
	
	ЗаполнитьГруппуОчередей(сводка.Очереди);
	ЗаполнитьГруппуОшибок(сводка.Ошибки);
	ЗаполнитьГруппуРегламентных(сводка.Регламентные);
	ЗаполнитьГруппуСсылок(сводка.Ссылки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуОчередей(пОчереди)
	
	ОчиститьПодчиненные(Элементы.ГруппаОчереди);
	
	Для Каждого очередь Из пОчереди Цикл
		имяЭлемента = "Очередь_" + очередь.Ключ;
		заголовок = СтрШаблон("%1: %2", очередь.Синоним,
			Обработки.обм_Дашборд.Очередь_ТекстСчётчика(очередь.Остаток, очередь.Ошибки));
		ДобавитьГиперссылку(имяЭлемента, заголовок, Элементы.ГруппаОчереди);
		ЭтаФорма.КартаПереходов.Вставить(имяЭлемента, очередь.ИмяФормыСписка);
		
	КонецЦикла;
	очередь = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуОшибок(пОшибки)
	
	ОчиститьПодчиненные(Элементы.ГруппаОшибки);
	
	Для Каждого ошибка Из пОшибки Цикл
		имяЭлемента = "Ошибка_" + ошибка.Ключ;
		ДобавитьГиперссылку(имяЭлемента, ошибка.Заголовок, Элементы.ГруппаОшибки);
		переход = Новый Структура;
		переход.Вставить("ИмяФормы", ошибка.ИмяФормы);
		переход.Вставить("Параметры", ошибка.Параметры);
		ЭтаФорма.КартаПереходов.Вставить(имяЭлемента, переход);
		
	КонецЦикла;
	ошибка = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуРегламентных(пРегламентные)
	
	ОчиститьПодчиненные(Элементы.ГруппаРегламентные);
	
	Для Каждого задание Из пРегламентные Цикл
		группа = Элементы.Добавить("ГруппаРЗ_" + задание.Имя, Тип("ГруппаФормы"), Элементы.ГруппаРегламентные);
		группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		группа.ОтображатьЗаголовок = Ложь;
		группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		
		кружок = Элементы.Добавить("РЗКартинка_" + задание.Имя, Тип("ДекорацияФормы"), группа);
		кружок.Вид = ВидДекорацииФормы.Картинка;
		Если задание.Использование Тогда
			кружок.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
			статус = "работает";
			
		Иначе
			кружок.Картинка = БиблиотекаКартинок.ОформлениеКругПустой;
			статус = "отключено";
			
		КонецЕсли;
		
		надпись = Элементы.Добавить("РЗ_" + задание.Имя, Тип("ДекорацияФормы"), группа);
		надпись.Заголовок = СтрШаблон("%1: %2", задание.Синоним, статус);
		надпись.Гиперссылка = Ложь;
		
	КонецЦикла;
	задание = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуСсылок(пСсылки)
	
	ОчиститьПодчиненные(Элементы.ГруппаСсылки);
	
	Для Каждого ссылка Из пСсылки Цикл
		имяЭлемента = "Ссылка_" + ссылка.Ключ;
		ДобавитьГиперссылку(имяЭлемента, ссылка.Заголовок, Элементы.ГруппаСсылки);
		ЭтаФорма.КартаПереходов.Вставить(имяЭлемента, ссылка.ИмяФормы);
		
	КонецЦикла;
	ссылка = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГиперссылку(пИмяЭлемента, пЗаголовок, пРодитель)
	
	элемент = Элементы.Добавить(пИмяЭлемента, Тип("ДекорацияФормы"), пРодитель);
	элемент.Заголовок = пЗаголовок;
	элемент.Гиперссылка = Истина;
	элемент.УстановитьДействие("Нажатие", "НажатиеПерехода");
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПодчиненные(пГруппа)
	
	Пока пГруппа.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(пГруппа.ПодчиненныеЭлементы[0]);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
