#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	общ.ФормаСпискаКакФормаВыбора(ЭтаФорма);
	УправлениеДиалогом();
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОчиститьОчередь(Команда)

	оповещение = Новый ОписаниеОповещения("ОчиститьОчередьПослеВводаДаты", ЭтотОбъект);
	срокДней = СрокХраненияНаСервере();
	датаГраницы = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса() - срокДней * 86400);
	ПоказатьВводДаты(оповещение, датаГраницы,
		"Удалить сообщения с датой раньше", ЧастиДаты.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОчередьПослеВводаДаты(датаГраницы, дополнительныеПараметры) Экспорт

	Если датаГраницы = Неопределено Тогда
		Возврат;

	КонецЕсли;

	длительнаяОперация = ОчиститьОчередьНаСервере(датаГраницы);
	оповещение = Новый ОписаниеОповещения("ОчиститьОчередьЗавершение", ЭтотОбъект);
	параметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	параметрыОжидания.ТекстСообщения = "Очистка очереди исходящих сообщений";
	параметрыОжидания.ВыводитьОкноОжидания = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(длительнаяОперация, оповещение, параметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ОчиститьОчередьНаСервере(Знач пДатаГраницы)

	Возврат ДлительныеОперации.ВыполнитьПроцедуру( ,
		"обм.Очереди_Очистить",
		обм.ВидОчередиИсходящие(),
		пДатаГраницы);

КонецФункции

&НаКлиенте
Процедура ОчиститьОчередьЗавершение(результат, дополнительныеПараметры) Экспорт

	Если ТипЗнч(результат) <> Тип("Структура") Тогда
		Возврат;

	КонецЕсли;

	Если результат.Статус = "Выполнено" Тогда
		ПоказатьОповещениеПользователя("Очистка", , "Очередь исходящих очищена");
		Элементы.Список.Обновить();

	ИначеЕсли результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение( , результат.ПодробноеПредставлениеОшибки);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОчистку(Команда)

	ПереключитьОчисткуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПереключитьОчисткуНаСервере()

	имяЗадания = Метаданные.РегламентныеЗадания.обм_Очистка_ИсходящиеСообщения.Имя;
	использование = Обработки.обм_Дашборд.Регламентное_Использование(имяЗадания);
	Обработки.обм_Дашборд.Регламентное_Использование_Установить(имяЗадания, Не использование);
	УправлениеДиалогом();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСрокХранения(Команда)

	текущийСрок = СрокХраненияНаСервере();
	оповещение = Новый ОписаниеОповещения("УстановитьСрокХраненияПослеВвода", ЭтотОбъект);
	ПоказатьВводЧисла(оповещение, текущийСрок, "Срок хранения (дней)", 5, 0);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСрокХраненияПослеВвода(срокДней, дополнительныеПараметры) Экспорт

	Если срокДней = Неопределено Тогда
		Возврат;

	КонецЕсли;

	УстановитьСрокХраненияНаСервере(срокДней);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СрокХраненияНаСервере()

	Возврат обм.ОчисткаИсходящих_СрокХраненияДней_Значение();

КонецФункции

&НаСервере
Процедура УстановитьСрокХраненияНаСервере(Знач пСрокДней)

	обм.ОчисткаИсходящих_СрокХраненияДней_Установить(пСрокДней);
	УправлениеДиалогом();

КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеДиалогом()

	Если Не Элементы.ФормаПереключитьОчистку.Видимость Тогда
		Возврат;

	КонецЕсли;

	использование = Обработки.обм_Дашборд.Регламентное_Использование(
		Метаданные.РегламентныеЗадания.обм_Очистка_ИсходящиеСообщения.Имя);
	срокДней = обм.ОчисткаИсходящих_СрокХраненияДней_Значение();

	Если использование Тогда
		Элементы.ФормаПереключитьОчистку.Заголовок = "Очистка работает";
		Элементы.ФормаПереключитьОчистку.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;

	Иначе
		Элементы.ФормаПереключитьОчистку.Заголовок = "Автоочистка отключена";
		Элементы.ФормаПереключитьОчистку.Картинка = БиблиотекаКартинок.ОформлениеКругПустой;

	КонецЕсли;

	Элементы.ФормаУстановитьСрокХранения.Заголовок = СтрШаблон("Срок хранения: %1 дн.", Формат(срокДней, "ЧГ=0"));

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
