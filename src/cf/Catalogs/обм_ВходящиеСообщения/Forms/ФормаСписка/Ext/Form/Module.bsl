#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	общ.ФормаСпискаКакФормаВыбора(ЭтаФорма);
	
	НастройкиОтбораУстановить();
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = обм_лит.ВходящиеСообщения_ИзмененыСтатусы() Тогда
		УправлениеДиалогом();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

&НаСервере
Процедура ЗапуститьОчередьНаСервере()

	обм.Получение_ОбработатьОчередь();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОчередь(Команда)
	
	ЗапуститьОчередьНаСервере();
	
	ПодключитьОбработчикОжидания("ВходящиеСообщения_ИзмененыСтатусы", 3, Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящиеСообщения_ИзмененыСтатусы()
	
	Оповестить(обм_лит.ВходящиеСообщения_ИзмененыСтатусы());
	
КонецПроцедуры

&НаСервере
Процедура НастройкиОтбораУстановить() 
	
	Список.Параметры.УстановитьЗначениеПараметра("ОтборСтатус", ОтборСтатус);
	УправлениеДиалогом();
	
КонецПроцедуры

&НаСервере
Процедура НастройкиОтбораПриИзмененииНаСервере() 
	
	НастройкиОтбораУстановить();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтбораПриИзменении(Элемент) 
	
	НастройкиОтбораПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура УправлениеДиалогом()
	
	Если Элементы.Список.Видимость Тогда
		Элементы.Список.Обновить();
		
	КонецЕсли; 
	
	Если Элементы.ФормаПереключитьРегламентное.Видимость Тогда
		использование1 = Обработки.обм_Дашборд.Регламентное_Использование(
			Метаданные.РегламентныеЗадания.обм_Получение_1_ПакетыДанных_Извлечь.Имя);
		использование2 = Обработки.обм_Дашборд.Регламентное_Использование(
			Метаданные.РегламентныеЗадания.обм_Получение_2_ПакетыДанных_Обработать.Имя);
		
		заголовокКнопки = Неопределено;
		картинкаКнопки = Неопределено;
		Если использование1 И использование2 Тогда
			заголовокКнопки = "Задание работает";
			картинкаКнопки = БиблиотекаКартинок.ОформлениеКругЗеленый;
			
		ИначеЕсли Не использование1 И Не использование2 Тогда
			заголовокКнопки = "Задание отключено";
			картинкаКнопки = БиблиотекаКартинок.ОформлениеКругПустой;
			
		Иначе
			заголовокКнопки = "Задание частично отключено";
			картинкаКнопки = БиблиотекаКартинок.ОформлениеКругЖелтый;
			
		КонецЕсли;

		Элементы.ФормаПереключитьРегламентное.Заголовок = заголовокКнопки;
		Элементы.ФормаПереключитьРегламентное.Картинка = картинкаКнопки;
					
	КонецЕсли;

	Если Элементы.ФормаПереключитьОчистку.Видимость Тогда
		использованиеОчистки = Обработки.обм_Дашборд.Регламентное_Использование(
			Метаданные.РегламентныеЗадания.обм_Очистка_ВходящиеСообщения.Имя);
		срокДней = обм.ОчисткаВходящих_СрокХраненияДней_Значение();

		Если использованиеОчистки Тогда
			Элементы.ФормаПереключитьОчистку.Заголовок = "Очистка работает";
			Элементы.ФормаПереключитьОчистку.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;

		Иначе
			Элементы.ФормаПереключитьОчистку.Заголовок = "Автоочистка отключена";
			Элементы.ФормаПереключитьОчистку.Картинка = БиблиотекаКартинок.ОформлениеКругПустой;

		КонецЕсли;

		Элементы.ФормаУстановитьСрокХранения.Заголовок = СтрШаблон(
			"Срок хранения: %1 дн.", Формат(срокДней, "ЧГ=0"));

	КонецЕсли;
	
	ОбновитьЗаголовокОчередиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПереключитьРегламентноеНаСервере()
	
	имя1 = Метаданные.РегламентныеЗадания.обм_Получение_1_ПакетыДанных_Извлечь.Имя;
	имя2 = Метаданные.РегламентныеЗадания.обм_Получение_2_ПакетыДанных_Обработать.Имя;
	использование = Обработки.обм_Дашборд.Регламентное_Использование(имя1)
		Или Обработки.обм_Дашборд.Регламентное_Использование(имя2);
	Обработки.обм_Дашборд.Регламентное_Использование_Установить(имя1, Не использование);
	Обработки.обм_Дашборд.Регламентное_Использование_Установить(имя2, Не использование);
	
	УправлениеДиалогом();

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРегламентное(Команда)
	ПереключитьРегламентноеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРазмерОчереди(Команда)
	
	ОбновитьЗаголовокОчередиНаСервере(Формат(ТекущаяДата(), "ДФ=HH:mm:ss")); // BSLLS:DeprecatedCurrentDate-off
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокОчередиНаСервере(Знач пВремя = "")
	
	Если ПустаяСтрока(пВремя) Тогда
		пВремя = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss");
		
	КонецЕсли;
	
	состояние = Обработки.обм_Дашборд.Очередь_Состояние("Входящие");
	счётчик = Обработки.обм_Дашборд.Очередь_ТекстСчётчика(состояние.Остаток, состояние.Ошибки);
	Элементы.ПоказатьРазмерОчереди.Заголовок = СтрШаблон(
		"%1 Остаток %2. Нажмите здесь чтобы пересчитать",
		пВремя,
		счётчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОчередь(Команда)

	оповещение = Новый ОписаниеОповещения("ОчиститьОчередьПослеВводаДаты", ЭтотОбъект);
	срокДней = СрокХраненияНаСервере();
	датаГраницы = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса() - срокДней * 86400);
	ПоказатьВводДаты(оповещение, датаГраницы,
		"Удалить сообщения с датой раньше", ЧастиДаты.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОчередьПослеВводаДаты(датаГраницы, дополнительныеПараметры) Экспорт

	Если датаГраницы = Неопределено Тогда
		Возврат;

	КонецЕсли;

	длительнаяОперация = ОчиститьОчередьНаСервере(датаГраницы);
	оповещение = Новый ОписаниеОповещения("ОчиститьОчередьЗавершение", ЭтотОбъект);
	параметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	параметрыОжидания.ТекстСообщения = "Очистка очереди входящих сообщений";
	параметрыОжидания.ВыводитьОкноОжидания = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(длительнаяОперация, оповещение, параметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ОчиститьОчередьНаСервере(Знач пДатаГраницы)

	Возврат ДлительныеОперации.ВыполнитьПроцедуру( ,
		"обм.Очереди_Очистить",
		обм.ВидОчередиВходящие(),
		пДатаГраницы);

КонецФункции

&НаКлиенте
Процедура ОчиститьОчередьЗавершение(результат, дополнительныеПараметры) Экспорт

	Если ТипЗнч(результат) <> Тип("Структура") Тогда
		Возврат;

	КонецЕсли;

	Если результат.Статус = "Выполнено" Тогда
		ПоказатьОповещениеПользователя("Очистка", , "Очередь входящих очищена");
		Элементы.Список.Обновить();

	ИначеЕсли результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение( , результат.ПодробноеПредставлениеОшибки);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОчистку(Команда)

	ПереключитьОчисткуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПереключитьОчисткуНаСервере()

	имяЗадания = Метаданные.РегламентныеЗадания.обм_Очистка_ВходящиеСообщения.Имя;
	использование = Обработки.обм_Дашборд.Регламентное_Использование(имяЗадания);
	Обработки.обм_Дашборд.Регламентное_Использование_Установить(имяЗадания, Не использование);
	УправлениеДиалогом();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСрокХранения(Команда)

	текущийСрок = СрокХраненияНаСервере();
	оповещение = Новый ОписаниеОповещения("УстановитьСрокХраненияПослеВвода", ЭтотОбъект);
	ПоказатьВводЧисла(оповещение, текущийСрок, "Срок хранения (дней)", 5, 0);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСрокХраненияПослеВвода(срокДней, дополнительныеПараметры) Экспорт

	Если срокДней = Неопределено Тогда
		Возврат;

	КонецЕсли;

	УстановитьСрокХраненияНаСервере(срокДней);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СрокХраненияНаСервере()

	Возврат обм.ОчисткаВходящих_СрокХраненияДней_Значение();

КонецФункции

&НаСервере
Процедура УстановитьСрокХраненияНаСервере(Знач пСрокДней)

	обм.ОчисткаВходящих_СрокХраненияДней_Установить(пСрокДней);
	УправлениеДиалогом();

КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Или ТипЗнч(Поле) <> Тип("ПолеФормы") Тогда 
		Возврат;
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "ПоследнийПриемник" Тогда
		последнийПриемникСсылка = СписокВыбор_СсылкаПоследнегоПриемникаНаСервере(Элемент.ТекущиеДанные.ПоследнийПриемник);
		ПоказатьЗначение(,последнийПриемникСсылка);
		
	ИначеЕсли Поле.Имя = "Примечание" Тогда
		текст = Новый ТекстовыйДокумент;
		текст.УстановитьТекст(Элемент.ТекущиеДанные.Примечание);
		текст.Показать("Примечание об обработке входящего сообщения " + Элемент.ТекущиеДанные.Наименование);
		
	Иначе
		СтандартнаяОбработка = Истина;

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбор_СсылкаПоследнегоПриемникаНаСервере(пПоследнийПриемникСтрВнутр)
	
	Возврат ЗначениеИзСтрокиВнутр(пПоследнийПриемникСтрВнутр);	

КонецФункции

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого строкаДинСписка Из Строки Цикл
		последнийПриемник = строкаДинСписка.Значение.Данные.ПоследнийПриемник; 
		Если ПустаяСтрока(последнийПриемник) Тогда
			Продолжить;
			
		КонецЕсли;
		
		последнийПриемникСсылка = ЗначениеИзСтрокиВнутр(последнийПриемник);
		
		оформлениеПП = строкаДинСписка.Значение.Оформление.Получить("ПоследнийПриемник");
		
		Если оформлениеПП = Неопределено Тогда
			Продолжить;
			
		КонецЕсли;
		
		оформлениеПП.УстановитьЗначениеПараметра("Текст", Строка(последнийПриемникСсылка));
		
	КонецЦикла;
	строкаДинСписка = Неопределено;
	
КонецПроцедуры
