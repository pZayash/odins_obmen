#Область ПрограммныйИнтерфейс

// Сводка очередей, регламентных заданий и ссылок. Вызов снаружи: Обработки.обм_Дашборд.Сводка().
//
// Возвращаемое значение:
//  Структура - ключи Очереди, Регламентные, Ссылки
Функция Сводка() Экспорт

	УстановитьПривилегированныйРежим(Истина); // BSLLS:SetPrivilegedMode-off

	очереди = Новый Массив;
	очереди.Добавить(ОчередьОписание("Измененные", Метаданные.РегистрыСведений.обм_Измененные));
	очереди.Добавить(ОчередьОписание("КОтправке", Метаданные.РегистрыСведений.обм_КОтправке));
	очереди.Добавить(ОчередьОписание("Входящие", Метаданные.Справочники.обм_ВходящиеСообщения));
	очереди.Добавить(ОчередьОписание("ПакетыДанных", Метаданные.Справочники.обм_ПакетыДанных));

	регламентные = Новый Массив;
	Для Каждого метаЗадания Из МетаданныеРегламентныхЗаданий() Цикл
		регламентные.Добавить(РегламентноеОписание(метаЗадания));

	КонецЦикла;
	метаЗадания = Неопределено;

	ссылки = Новый Массив;
	ссылки.Добавить(СсылкаОписание("Настройки", Метаданные.Справочники.обм_Настройки));
	ссылки.Добавить(СсылкаОписание("Обработчики", Метаданные.Справочники.общ_Обработчики));
	ссылки.Добавить(СсылкаОписание("Исходящие", Метаданные.Справочники.обм_ИсходящиеСообщения));
	ссылки.Добавить(СсылкаОписание("Отправленные", Метаданные.РегистрыСведений.обм_ОтправленныеСообщения));

	результат = Новый Структура;
	результат.Вставить("Очереди", очереди);
	результат.Вставить("Регламентные", регламентные);
	результат.Вставить("Ссылки", ссылки);

	УстановитьПривилегированныйРежим(Ложь);

	Возврат результат;

КонецФункции

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция МетаданныеРегламентныхЗаданий()

	результат = Новый Массив;
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Отправка_1_ИсходящиеСообщения_Создать);
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Отправка_2_ИсходящиеСообщения_Отправить);
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Получение_1_ПакетыДанных_Извлечь);
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Получение_2_ПакетыДанных_Обработать);
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Очистка_ВходящиеСообщения);
	результат.Добавить(Метаданные.РегламентныеЗадания.обм_Очистка_ИсходящиеСообщения);

	Возврат результат;

КонецФункции

Функция ОчередьОписание(пКлюч, пМетаданныеОбъекта)

	описание = Новый Структура;
	описание.Вставить("Ключ", пКлюч);
	описание.Вставить("Синоним", пМетаданныеОбъекта.Синоним);
	описание.Вставить("Размер", Очередь_Размер(пКлюч));
	описание.Вставить("ИмяФормыСписка", ИмяФормыСписка(пМетаданныеОбъекта));

	Возврат описание;

КонецФункции

Функция РегламентноеОписание(пМетаЗадания)

	описание = Новый Структура;
	описание.Вставить("Имя", пМетаЗадания.Имя);
	описание.Вставить("Синоним", пМетаЗадания.Синоним);
	описание.Вставить("Использование", Обработки.обм_Дашборд.Регламентное_Использование(пМетаЗадания.Имя));

	Возврат описание;

КонецФункции

Функция СсылкаОписание(пКлюч, пМетаданныеОбъекта)

	описание = Новый Структура;
	описание.Вставить("Ключ", пКлюч);
	описание.Вставить("Заголовок", пМетаданныеОбъекта.Синоним);
	описание.Вставить("ИмяФормы", ИмяФормыСписка(пМетаданныеОбъекта));

	Возврат описание;

КонецФункции

Функция ИмяФормыСписка(пМетаданныеОбъекта)

	формаСписка = пМетаданныеОбъекта.Формы.Найти("ФормаСписка");
	Если формаСписка = Неопределено Тогда
		Возврат пМетаданныеОбъекта.ПолноеИмя() + ".ФормаСписка";

	КонецЕсли;

	Возврат формаСписка.ПолноеИмя();

КонецФункции

Функция Очередь_Размер(пКлючОчереди)

	имяТаблицы = Очередь_ИмяТаблицы(пКлючОчереди);
	Если ПустаяСтрока(имяТаблицы) Тогда
		Возврат 0;

	КонецЕсли;

	запрос = Новый Запрос;
	// имя таблицы из белого списка Очередь_ИмяТаблицы, параметром не задать
	// BSLLS:QueryParseError-off
	запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Размер
	|ИЗ
	|	" + имяТаблицы + " КАК Очередь";
	// BSLLS:QueryParseError-on

	выборка = запрос.Выполнить().Выбрать();
	Если выборка.Следующий() Тогда
		Возврат выборка.Размер;

	КонецЕсли;

	Возврат 0;

КонецФункции

Функция Очередь_ИмяТаблицы(пКлючОчереди)

	Если пКлючОчереди = "Измененные" Тогда
		Возврат Метаданные.РегистрыСведений.обм_Измененные.ПолноеИмя();

	ИначеЕсли пКлючОчереди = "КОтправке" Тогда
		Возврат Метаданные.РегистрыСведений.обм_КОтправке.ПолноеИмя();

	ИначеЕсли пКлючОчереди = "Входящие" Тогда
		Возврат Метаданные.Справочники.обм_ВходящиеСообщения.ПолноеИмя();

	ИначеЕсли пКлючОчереди = "ПакетыДанных" Тогда
		Возврат Метаданные.Справочники.обм_ПакетыДанных.ПолноеИмя();

	Иначе
		Возврат "";

	КонецЕсли;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
