#Область ПрограммныйИнтерфейс

// Сводка очередей обмена, регламентных заданий, ссылок и ошибок журнала за сегодня.
//
// Возвращаемое значение:
//  Структура - ключи Очереди, Регламентные, Ссылки, Ошибки (массивы структур)
Функция Сводка() Экспорт

	Возврат Создать().Сводка();

КонецФункции

// Признак использования предопределённого регламентного задания.
//
// Параметры:
//  пИмяЗадания - Строка - имя объекта метаданных РегламентноеЗадание
//
// Возвращаемое значение:
//  Булево - Использование; Ложь если задание не найдено
Функция Регламентное_Использование(пИмяЗадания) Экспорт

	задание = Регламентное_Объект(пИмяЗадания);
	Если задание = Неопределено Тогда
		Возврат Ложь;

	КонецЕсли;

	Возврат задание.Использование;

КонецФункции

// Устанавливает использование предопределённого регламентного задания.
//
// Параметры:
//  пИмяЗадания - Строка - имя объекта метаданных РегламентноеЗадание
//  пИспользование - Булево - новое значение Использование
Процедура Регламентное_Использование_Установить(пИмяЗадания, пИспользование) Экспорт

	задание = Регламентное_Объект(пИмяЗадания);
	Если задание = Неопределено Тогда
		Возврат;

	КонецЕсли;

	задание.Использование = пИспользование;
	задание.Записать();

КонецПроцедуры

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

Функция Регламентное_Объект(пИмяЗадания)

	результат = Неопределено;
	Попытка
		мета = Метаданные.РегламентныеЗадания.Найти(пИмяЗадания);
		Если мета = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Регламентное задание не найдено: %1", пИмяЗадания);

		КонецЕсли;

		результат = РегламентныеЗадания.НайтиПредопределенное(мета);
		Если результат = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Предопределённое регламентное задание не найдено: %1", пИмяЗадания);

		КонецЕсли;

	Исключение
		общ.Ошибка_ВЖурналРегистрации(
			обм.ИмяСобытияЖурналаРегистрации("Регламентное"),
			ИнформацияОбОшибке());

	КонецПопытки;

	Возврат результат;

КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
